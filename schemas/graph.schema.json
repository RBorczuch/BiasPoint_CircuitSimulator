    "GraphNode": {
      "additionalProperties": false,
      "description": "A node of an analysis graph: its type (``sim/tran``), widget values and placement.\n\n``version``: of its type's parameters when it was made (older ones are migrated by the\ncatalogue); ``title``: the user's name for it (\"\" = the type's); ``bypass``: switched off,\nits input passed on to an output of the same type, else its branch skipped;\n``param_inputs``: parameters turned into ``scalar`` input sockets of the same name (a number\nfrom another node sets them).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "version": {
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "bypass": {
          "default": false,
          "title": "Bypass",
          "type": "boolean"
        },
        "pos": {
          "default": [
            0.0,
            0.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Pos",
          "type": "array"
        },
        "size": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        },
        "param_inputs": {
          "items": {
            "type": "string"
          },
          "title": "Param Inputs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "GraphNode",
      "type": "object"
    },
