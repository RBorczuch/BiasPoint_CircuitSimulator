    "Parasitic": {
      "additionalProperties": false,
      "description": "A non-ideal property of a part: an extra R, L or C in series or in parallel with it.\n\nStored like any parameter (``key`` in the instance params); empty = absent (ideal).\nThe netlister expands it into a separate element.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "element": {
          "enum": [
            "R",
            "L",
            "C"
          ],
          "title": "Element",
          "type": "string"
        },
        "connection": {
          "enum": [
            "series",
            "parallel"
          ],
          "title": "Connection",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "element",
        "connection",
        "unit"
      ],
      "title": "Parasitic",
      "type": "object"
    },
