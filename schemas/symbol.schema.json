    "SpiceMapping": {
      "additionalProperties": false,
      "description": "How an instance becomes a SPICE element line.\n\n``nodes`` lists pin numbers in SPICE node order; ``\"=0\"`` stands for the ground node\n(used e.g. by the ideal op-amp, a VCVS referenced to ground).",
      "properties": {
        "element": {
          "enum": [
            "R",
            "C",
            "L",
            "V",
            "I",
            "E",
            "F",
            "G",
            "H",
            "B",
            "D",
            "Q",
            "M",
            "J",
            "S",
            "X",
            "A"
          ],
          "title": "Element",
          "type": "string"
        },
        "nodes": {
          "items": {
            "type": "string"
          },
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "element",
        "nodes"
      ],
      "title": "SpiceMapping",
      "type": "object"
